# Client Port & Public URL
PORT=5000
NEXT_PUBLIC_APP_URL=http://localhost:5000

# Backend API Base URL (proxied via Next.js rewrite /api/py -> http://127.0.0.1:3000/api/v1)
NEXT_PUBLIC_API_URL=/api/py

# Direct Backend Server URL (used for media streaming and static uploads)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
